# SPORE backend environment template.
# Copy to .env and edit. Placeholder values only; never commit real secrets.

# --- Postgres (used by the postgres service) ---
POSTGRES_USER=spore
POSTGRES_PASSWORD=changeme
POSTGRES_DB=spore

# --- Database connection (host `postgres` = compose service name) ---
DATABASE_URL=postgresql://spore:changeme@postgres:5432/spore

# --- Chain ---
# Replace with the real Robinhood Chain RPC endpoint.
RPC_URL=https://example-rpc.robinhoodchain.example
CHAIN_ID=4663

# --- Contract addresses (placeholders; set after deployment) ---
CONTRACT_REGISTRY=0x0000000000000000000000000000000000000000
CONTRACT_CREDIT_MANAGER=0x0000000000000000000000000000000000000000
CONTRACT_BACKER_VAULT=0x0000000000000000000000000000000000000000
CONTRACT_SCORE_ORACLE=0x0000000000000000000000000000000000000000
CONTRACT_FEE_ROUTER=0x0000000000000000000000000000000000000000
ASSET_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_DECIMALS=18

# --- Indexer ---
# First block to backfill from (set to the deployment block).
DEPLOY_BLOCK=0
CONFIRMATIONS=12
INDEXER_POLL_MS=4000

# --- API ---
API_PORT=3001
LOG_LEVEL=info

# --- Score engine ---
SCORE_MODEL_VERSION=1
SCORE_INTERVAL_MS=300000

# --- Oracle publisher ---
# WARNING: NEVER commit a real private key. Leave this empty in version control and
# set it in your host's secret store / environment. The oracle-publisher refuses to
# start with an empty or placeholder key.
ORACLE_PRIVATE_KEY=
ORACLE_PUBLISH_INTERVAL_MS=300000
